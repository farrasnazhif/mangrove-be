# Copy to .env.staging (ignored by Git), then replace credentials and hosts.
ENVIRONMENT=staging
DATABASE_URL=postgresql+asyncpg://replace-user:replace-password@replace-db-host:5432/mangrove
JWT_SECRET=change-me
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=86400
CSRF_TOKEN_EXPIRE=3600
CORS_ORIGINS=["https://replace-staging-frontend.example"]
# Keep unapproved until the project supplies the real field-study boundary.
BOUNDARY_IS_SYNTHETIC=true
BOUNDARY_APPROVED=false
BOUNDARY_SOURCE=synthetic-placeholder
BOUNDARY_REVISION=synthetic-v1
