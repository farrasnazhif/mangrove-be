# Copy to .env.production (ignored by Git). Generate a distinct production JWT secret.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://replace-user:replace-password@replace-db-host:5432/mangrove
JWT_SECRET=change-me
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=86400
CSRF_TOKEN_EXPIRE=3600
CORS_ORIGINS=["https://replace-production-frontend.example"]
BOUNDARY_IS_SYNTHETIC=true
BOUNDARY_APPROVED=false
BOUNDARY_SOURCE=synthetic-placeholder
BOUNDARY_REVISION=synthetic-v1

# Private AWS S3 bucket; IAM role credentials are used when explicit keys are absent.
S3_ENABLED=true
S3_BUCKET=replace-production-private-photo-bucket
S3_REGION=us-east-1
# For another S3-compatible provider, set an HTTPS S3_ENDPOINT_URL and both
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY through your secret manager.
PHOTO_MAX_BYTES=5242880
PHOTO_MAX_PIXELS=20000000
PHOTO_URL_TTL_SECONDS=300
