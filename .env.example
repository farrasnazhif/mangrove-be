DATABASE_URL=postgresql+asyncpg://mangrove:mangrove@localhost:5432/mangrove
# Alternate environment templates: config/staging.env.example and config/production.env.example.
# If a local PostgreSQL service already uses 5432, change BOTH values to 5433.
POSTGRES_PORT=5432
JWT_SECRET=change-me
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Local HTTP only. Staging/production require HTTPS, true and a strong JWT_SECRET.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=86400
CSRF_TOKEN_EXPIRE=3600

# Synthetic placeholder only; not an approved Surabaya/Pamurbaya boundary.
BOUNDARY_LON_MIN=112.60
BOUNDARY_LON_MAX=112.85
BOUNDARY_LAT_MIN=-7.40
BOUNDARY_LAT_MAX=-7.15
BOUNDARY_SRID=4326
BOUNDARY_SOURCE=synthetic-placeholder
BOUNDARY_REVISION=synthetic-v1
BOUNDARY_IS_SYNTHETIC=true
BOUNDARY_APPROVED=false

SEED_MANAGER_EMAIL=manager.synthetic@example.test
# SEED_MANAGER_PASSWORD: optional env value, otherwise entered through a hidden prompt.
# No default password is shipped. Existing seed passwords are never overwritten.

LANGFLOW_URL=
LANGFLOW_API_KEY=
LANGFLOW_FLOW_ID=
